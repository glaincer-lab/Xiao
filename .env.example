# ===== 云端 LLM =====
# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 阿里云百炼 / 通义（DashScope 兼容模式；ASR 也复用此 key）
DASHSCOPE_API_KEY=sk-xxxxxxxx

# ===== 云端 ASR =====
# 阿里云百炼 Paraformer 实时识别，复用 DASHSCOPE_API_KEY

# ===== 唤醒词（Sherpa-ONNX KWS，本地中文「小二」，免费开源，无需 key）=====
# 本地离线唤醒，模型在 config.yaml 的 wake_word.model_dir 配置

# ===== 可选：火山引擎（豆包）ASR/TTS =====
VOLC_ASR_APP_ID=
VOLC_ASR_TOKEN=
VOLC_TTS_APP_ID=
VOLC_TTS_TOKEN=
